{
  "openapi": "3.1.0",
  "info": {
    "title": "toshers",
    "version": "0.1.0",
    "description": "A curated REST + MCP library over Henry Mayhew's 1851 London Labour and the London Poor, Vol. II — the street-finders (bone-grubbers, pure-finders, sewer-hunters/toshers, mud-larks, dustmen). Every claim is line-citable against source.txt. No auth, CORS wide open.",
    "license": { "name": "Public domain (source); code MIT", "identifier": "MIT" },
    "contact": { "url": "https://github.com/skyblue-will/toshers" }
  },
  "servers": [
    { "url": "https://toshers.vercel.app", "description": "Production" }
  ],
  "tags": [
    { "name": "catalogue", "description": "Master catalogue and navigation" },
    { "name": "chapter", "description": "Chapter-level primary source" },
    { "name": "character", "description": "Character testimonies (first-person voices)" },
    { "name": "synthesis", "description": "Derived/curated second-order endpoints" },
    { "name": "search", "description": "Search over the corpus" },
    { "name": "source", "description": "Verbatim source.txt access" }
  ],
  "paths": {
    "/api/index": {
      "get": {
        "tags": ["catalogue"],
        "summary": "Master catalogue",
        "description": "Returns source metadata, all chapter summaries, all character summaries, INDEX.md contents, version, and git commit. Call this once at session start. Add ?depth=shallow for a ~2kb navigation-only variant (ids + titles/labels only, no INDEX.md, no game_hooks).",
        "parameters": [
          { "name": "depth", "in": "query", "schema": { "type": "string", "enum": ["shallow", "full"], "default": "full" }, "description": "'shallow' returns ids + titles + the REST map (~2kb). 'full' returns the complete catalogue (~16kb)." }
        ],
        "responses": {
          "200": {
            "description": "Master catalogue",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MasterIndex" } } }
          }
        }
      }
    },
    "/api/chapters": {
      "get": {
        "tags": ["chapter"],
        "summary": "List all chapters",
        "responses": {
          "200": {
            "description": "Chapters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "chapters": { "type": "array", "items": { "$ref": "#/components/schemas/ChapterMeta" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/chapters/{id}": {
      "get": {
        "tags": ["chapter"],
        "summary": "One chapter",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "format", "in": "query", "schema": { "type": "string", "enum": ["raw"] }, "description": "If 'raw', returns the full markdown file as text/markdown" },
          { "name": "profile", "in": "query", "schema": { "type": "string", "enum": ["minimal", "facts", "full"], "default": "full" }, "description": "'minimal' = metadata only (no body); 'facts' = frontmatter minus game_hooks + body; 'full' = everything." }
        ],
        "responses": {
          "200": {
            "description": "Chapter",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Chapter" } },
              "text/markdown": { "schema": { "type": "string" } }
            }
          },
          "404": { "description": "Chapter id not found" }
        }
      }
    },
    "/api/chapters/{id}/annotated": {
      "get": {
        "tags": ["chapter"],
        "summary": "Chapter body with inline annotations (glossary terms + prices) by character offset",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Annotated chapter", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AnnotatedBody" } } } },
          "404": { "description": "Chapter id not found" }
        }
      }
    },
    "/api/characters": {
      "get": {
        "tags": ["character"],
        "summary": "List all character testimonies",
        "responses": {
          "200": {
            "description": "Characters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "characters": { "type": "array", "items": { "$ref": "#/components/schemas/CharacterMeta" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/characters/{id}": {
      "get": {
        "tags": ["character"],
        "summary": "One character testimony",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "format", "in": "query", "schema": { "type": "string", "enum": ["raw"] } },
          { "name": "profile", "in": "query", "schema": { "type": "string", "enum": ["minimal", "facts", "full"], "default": "full" }, "description": "'minimal' = metadata only (no body); 'facts' = frontmatter minus game_hooks + body; 'full' = everything." }
        ],
        "responses": {
          "200": {
            "description": "Character",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Character" } },
              "text/markdown": { "schema": { "type": "string" } }
            }
          },
          "404": { "description": "Character id not found" }
        }
      }
    },
    "/api/characters/{id}/annotated": {
      "get": {
        "tags": ["character"],
        "summary": "Testimony body with inline annotations (glossary terms + prices) by character offset",
        "description": "Returns the verbatim body plus an `annotations` array. Each annotation has `{type, start, end, matched_text, ...}` — `gloss` carries the full glossary entry, `price` carries the parsed £/s/d and a CPI-based modern-GBP estimate. Offsets are UTF-16 code units. Use for building a reader with glossary popovers and currency-conversion hovers.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Annotated testimony", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AnnotatedBody" } } } },
          "404": { "description": "Character id not found" }
        }
      }
    },
    "/api/characters/{id}/voice": {
      "get": {
        "tags": ["synthesis"],
        "summary": "Voice-casting / TTS profile for one character",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Voice profile", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VoiceProfile" } } } },
          "404": { "description": "Character id not found" }
        }
      }
    },
    "/api/glossary": {
      "get": {
        "tags": ["synthesis"],
        "summary": "Victorian slang glossary",
        "responses": {
          "200": { "description": "Glossary", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Glossary" } } } }
        }
      }
    },
    "/api/glossary/{term}": {
      "get": {
        "tags": ["synthesis"],
        "summary": "One glossary entry",
        "parameters": [{ "name": "term", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Glossary entry", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GlossaryEntry" } } } },
          "404": { "description": "Term not found" }
        }
      }
    },
    "/api/locations": {
      "get": {
        "tags": ["synthesis"],
        "summary": "Structured London geography",
        "responses": {
          "200": { "description": "Locations", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Locations" } } } }
        }
      }
    },
    "/api/relationships": {
      "get": {
        "tags": ["synthesis"],
        "summary": "Cross-reference graph (character → mentioned)",
        "responses": {
          "200": { "description": "Relationships", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Relationships" } } } }
        }
      }
    },
    "/api/relationships/mentions": {
      "get": {
        "tags": ["synthesis"],
        "summary": "Reverse lookup — find edges pointing AT a given person, place, or institution",
        "description": "Case-insensitive substring match against each edge's `to.label` and `to.id`. Answers questions `/api/relationships` can't: 'who mentions Long J——?', 'which characters reference Bermondsey?'.",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" }, "description": "Name or label fragment, e.g. 'Long J', 'Bermondsey', 'Bradbury'" }
        ],
        "responses": {
          "200": { "description": "Matching edges", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MentionsResult" } } } },
          "400": { "description": "Missing 'q' query parameter" }
        }
      }
    },
    "/api/quotes": {
      "get": {
        "tags": ["synthesis"],
        "summary": "Canonical quotes with dialect and TTS annotation",
        "parameters": [
          { "name": "speaker_id", "in": "query", "schema": { "type": "string" } },
          { "name": "chapter_ref", "in": "query", "schema": { "type": "string" } },
          { "name": "theme", "in": "query", "schema": { "type": "string" } },
          { "name": "dialect_level", "in": "query", "schema": { "type": "string", "enum": ["standard", "moderate", "heavy"] } }
        ],
        "responses": {
          "200": { "description": "Quotes", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Quotes" } } } }
        }
      }
    },
    "/api/illustrations": {
      "get": {
        "tags": ["synthesis"],
        "summary": "Original 1861 woodcut plates (Beard daguerreotypes) with PD image URLs",
        "responses": {
          "200": { "description": "Illustrations", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Illustrations" } } } }
        }
      }
    },
    "/api/quiz": {
      "get": {
        "tags": ["synthesis"],
        "summary": "Fact-check quiz triples",
        "parameters": [
          { "name": "chapter_ref", "in": "query", "schema": { "type": "string" } },
          { "name": "difficulty", "in": "query", "schema": { "type": "string", "enum": ["easy", "medium", "hard"] } }
        ],
        "responses": {
          "200": { "description": "Quiz", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Quiz" } } } }
        }
      }
    },
    "/api/prices/normalize": {
      "get": {
        "tags": ["synthesis"],
        "summary": "Pre-decimal £/s/d → modern GBP on four economic bases",
        "description": "Returns real_price (CPI), labour_value (avg earnings), income_value (GDP per capita), and economic_share (GDP share). These differ by an order of magnitude — use the one appropriate to what you are comparing (consumer goods vs. wages vs. industry totals). Accept either the numeric triple or a single `literal` string (e.g. '£3 5s 6d', '6d', '3l. 5s.', '£148,000').",
        "parameters": [
          { "name": "literal", "in": "query", "schema": { "type": "string" }, "description": "Pre-decimal literal, e.g. '£3 5s 6d'. Takes precedence over pounds/shillings/pence if both are passed." },
          { "name": "pounds", "in": "query", "schema": { "type": "number", "minimum": 0 } },
          { "name": "shillings", "in": "query", "schema": { "type": "number", "minimum": 0 } },
          { "name": "pence", "in": "query", "schema": { "type": "number", "minimum": 0 } }
        ],
        "responses": {
          "200": { "description": "Normalized price", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NormalizedPrice" } } } }
        }
      }
    },
    "/api/search": {
      "get": {
        "tags": ["search"],
        "summary": "Substring search across source.txt",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 } },
          { "name": "context", "in": "query", "schema": { "type": "integer", "minimum": 0, "maximum": 10, "default": 2 } }
        ],
        "responses": {
          "200": { "description": "Search hits", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SearchResult" } } } }
        }
      }
    },
    "/api/search/semantic": {
      "get": {
        "tags": ["search"],
        "summary": "Semantic (embedding) search — finds concepts without exact wording",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 } },
          { "name": "kind", "in": "query", "schema": { "type": "string", "enum": ["source", "chapter", "character"] } }
        ],
        "responses": {
          "200": { "description": "Ranked hits with score 0-1", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SemanticSearchResult" } } } },
          "503": { "description": "Semantic path unavailable — fall back to /api/search" }
        }
      }
    },
    "/api/source": {
      "get": {
        "tags": ["source"],
        "summary": "Verbatim source.txt slice (capped 500 lines)",
        "parameters": [
          { "name": "start", "in": "query", "required": true, "schema": { "type": "integer", "minimum": 1 } },
          { "name": "end", "in": "query", "required": true, "schema": { "type": "integer", "minimum": 1 } },
          { "name": "format", "in": "query", "schema": { "type": "string", "enum": ["raw"] } }
        ],
        "responses": {
          "200": {
            "description": "Line range",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SourceSlice" } },
              "text/plain": { "schema": { "type": "string" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChapterMeta": {
        "type": "object",
        "required": ["id", "url", "chapter", "title", "source_lines", "hook", "file"],
        "properties": {
          "id": { "type": "string" },
          "url": { "type": "string" },
          "chapter": { "type": "string" },
          "title": { "type": "string" },
          "source_lines": { "type": "string" },
          "hook": { "type": "string" },
          "file": { "type": "string" }
        }
      },
      "CharacterMeta": {
        "type": "object",
        "required": ["id", "url", "label", "source_lines", "file"],
        "properties": {
          "id": { "type": "string" },
          "url": { "type": "string" },
          "label": { "type": "string" },
          "occupation": { "type": "string" },
          "chapter": { "type": "string" },
          "source_lines": { "type": "string" },
          "anonymity": { "type": "string" },
          "voice_type": { "type": "string" },
          "age_stated": { "type": "string" },
          "origin": { "type": "string" },
          "dialect_level": { "type": "string" },
          "speech_notes": { "type": "string" },
          "key_facts": { "type": "array", "items": { "type": "string" } },
          "game_hooks": { "type": "array", "items": { "type": "string" } },
          "file": { "type": "string" }
        }
      },
      "Chapter": {
        "type": "object",
        "required": ["id", "url", "meta", "body"],
        "properties": {
          "id": { "type": "string" },
          "url": { "type": "string" },
          "source_lines": { "type": ["string", "null"] },
          "meta": { "type": "object", "additionalProperties": true },
          "body": { "type": "string" }
        }
      },
      "Character": {
        "type": "object",
        "required": ["id", "url", "meta", "body"],
        "properties": {
          "id": { "type": "string" },
          "url": { "type": "string" },
          "source_lines": { "type": ["string", "null"] },
          "meta": { "type": "object", "additionalProperties": true },
          "body": { "type": "string" }
        }
      },
      "MasterIndex": {
        "type": "object",
        "properties": {
          "version": { "type": ["string", "null"] },
          "commit": { "type": ["string", "null"] },
          "ref": { "type": ["string", "null"] },
          "source": {
            "type": "object",
            "properties": {
              "file": { "type": "string" },
              "total_lines": { "type": "integer" },
              "total_words": { "type": "integer" },
              "description": { "type": "string" }
            }
          },
          "chapters": { "type": "array", "items": { "$ref": "#/components/schemas/ChapterMeta" } },
          "characters": { "type": "array", "items": { "$ref": "#/components/schemas/CharacterMeta" } },
          "indexes": {
            "type": "object",
            "properties": {
              "source": { "type": "string" },
              "characters": { "type": "string" }
            }
          },
          "api": { "type": "object", "additionalProperties": true }
        }
      },
      "VoiceProfile": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "url": { "type": "string" },
          "label": { "type": "string" },
          "gender": { "type": "string", "enum": ["male", "female", "unknown"] },
          "age_band": { "type": "string", "enum": ["child", "youth", "adult", "elder", "unknown"] },
          "age_stated": { "type": ["string", "null"] },
          "origin": { "type": ["string", "null"] },
          "dialect_level": { "type": "string", "enum": ["standard", "moderate", "heavy", "composite"] },
          "accent_hint": { "type": "string" },
          "speech_notes": { "type": "string" },
          "pronunciation_overrides": {
            "type": "array",
            "description": "Spelling → IPA pairs for Mayhew's phonetic renderings. Without these a TTS engine mangles heavy-dialect characters.",
            "items": {
              "type": "object",
              "required": ["spelling", "ipa"],
              "properties": {
                "spelling": { "type": "string" },
                "ipa": { "type": "string" },
                "note": { "type": "string" }
              }
            }
          },
          "suggested_voice_model": { "type": "string", "description": "Generic voice-model descriptor a casting pipeline can match against." },
          "ssml_hints": { "type": ["string", "null"], "description": "Per-character SSML guidance where relevant." }
        }
      },
      "AnnotationGloss": {
        "type": "object",
        "required": ["type", "term", "matched_text", "start", "end", "entry"],
        "properties": {
          "type": { "type": "string", "enum": ["gloss"] },
          "term": { "type": "string" },
          "matched_text": { "type": "string" },
          "start": { "type": "integer" },
          "end": { "type": "integer" },
          "entry": { "$ref": "#/components/schemas/GlossaryEntry" }
        }
      },
      "AnnotationPrice": {
        "type": "object",
        "required": ["type", "matched_text", "start", "end", "pounds", "shillings", "pence", "decimal_pounds_1851", "modern_gbp_approx_cpi"],
        "properties": {
          "type": { "type": "string", "enum": ["price"] },
          "matched_text": { "type": "string" },
          "start": { "type": "integer" },
          "end": { "type": "integer" },
          "pounds": { "type": "number" },
          "shillings": { "type": "number" },
          "pence": { "type": "number" },
          "decimal_pounds_1851": { "type": "number" },
          "modern_gbp_approx_cpi": { "type": "number" }
        }
      },
      "AnnotatedBody": {
        "type": "object",
        "required": ["id", "url", "body", "annotations", "annotation_summary"],
        "properties": {
          "id": { "type": "string" },
          "url": { "type": "string" },
          "source_lines": { "type": ["string", "null"] },
          "body": { "type": "string" },
          "annotations": {
            "type": "array",
            "items": {
              "oneOf": [
                { "$ref": "#/components/schemas/AnnotationGloss" },
                { "$ref": "#/components/schemas/AnnotationPrice" }
              ]
            }
          },
          "annotation_summary": {
            "type": "object",
            "properties": {
              "gloss_count": { "type": "integer" },
              "price_count": { "type": "integer" },
              "body_length": { "type": "integer" }
            }
          }
        }
      },
      "GlossaryEntry": {
        "type": "object",
        "properties": {
          "term": { "type": "string" },
          "pos": { "type": "string" },
          "definition": { "type": "string" },
          "chapter_ref": { "type": "string" },
          "source_lines": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
          "etymology": { "type": ["string", "null"] }
        }
      },
      "Glossary": {
        "type": "object",
        "properties": {
          "version": { "type": "integer" },
          "description": { "type": "string" },
          "entries": { "type": "array", "items": { "$ref": "#/components/schemas/GlossaryEntry" } }
        }
      },
      "LocationEntry": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "coords": { "type": ["array", "null"], "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "era": { "type": "string" },
          "description": { "type": "string" },
          "chapter_refs": { "type": "array", "items": { "type": "string" } },
          "character_refs": { "type": "array", "items": { "type": "string" } },
          "source_lines": { "type": ["array", "null"], "items": { "type": "integer" } }
        }
      },
      "Locations": {
        "type": "object",
        "properties": {
          "version": { "type": "integer" },
          "entries": { "type": "array", "items": { "$ref": "#/components/schemas/LocationEntry" } }
        }
      },
      "RelationshipEdge": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "from": { "type": "object" },
          "to": { "type": "object" },
          "type": { "type": "string" },
          "description": { "type": "string" },
          "source_lines": { "type": ["array", "null"], "items": { "type": "integer" } }
        }
      },
      "Relationships": {
        "type": "object",
        "properties": {
          "version": { "type": "integer" },
          "edges": { "type": "array", "items": { "$ref": "#/components/schemas/RelationshipEdge" } }
        }
      },
      "QuoteEntry": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "speaker_id": { "type": "string" },
          "speaker_label": { "type": "string" },
          "chapter_ref": { "type": "string" },
          "source_lines": { "type": "array", "items": { "type": "integer" } },
          "dialect_level": { "type": "string", "enum": ["standard", "moderate", "heavy"] },
          "theme": { "type": "string" },
          "tts_normalized": { "type": "string" },
          "context": { "type": "string" }
        }
      },
      "QuoteCoverage": {
        "type": "object",
        "required": ["curated_count", "total_curated", "policy", "exhaustive"],
        "properties": {
          "curated_count": { "type": "integer", "description": "Entries returned after applied filters." },
          "total_curated": { "type": "integer", "description": "Total curated entries in the collection (before filters)." },
          "policy": { "type": "string", "description": "Selection policy describing what the curation is and isn't." },
          "exhaustive": { "type": "boolean", "description": "Always false — the corpus has more quotable lines than the curation. Use search/get_source_lines beyond the curated set." }
        }
      },
      "Quotes": {
        "type": "object",
        "properties": {
          "version": { "type": "integer" },
          "entries": { "type": "array", "items": { "$ref": "#/components/schemas/QuoteEntry" } },
          "coverage": { "$ref": "#/components/schemas/QuoteCoverage" }
        }
      },
      "IllustrationEntry": {
